# Keep this value server-side. Never place it in web/app.js or another client file.
GROQ_API_KEY=your_groq_api_key

# Optional override for the Brain MRI model weights (.keras file).
CLINIQ_MRI_MODEL_PATH=

# Optional override for class_names.json exported from the same MRI training run.
CLINIQ_MRI_CLASS_NAMES_PATH=

# Optional overrides. Default: skin/artifacts/six-class/skin_six.keras and its
# matching model_manifest.json, exported by the NEW six-class GPU training run.
# Legacy artifacts in skin/artifacts/ are not loaded by default. Restart after changes.
SKIN_MODEL_PATH=
SKIN_MANIFEST_PATH=
# JPEG/PNG multipart `file`; default 10 MiB, checked before full decode/inference.
SKIN_MAX_UPLOAD_BYTES=10485760
# Original width * height, checked before decoding; 120 MP includes 108 MP photos.
SKIN_MAX_PIXELS=120000000
SKIN_TOP_K=3
# Leave empty for backend defaults: Keras validation manifest, or prospective
# uncalibrated MAKE/native22 confidence threshold below. Restart after changes.
SKIN_ABSTAIN_THRESHOLD=

# Optional ready-to-use pretrained backend; no training or request-time downloads.
# Recommended verified local deployment: make (fixed six-candidate zero-shot).
# keras preserves the old artifact; pretrained selects the native22 research backend.
SKIN_BACKEND=keras
# Empty uses the pinned skin/artifacts/make/<revision>/ Git LFS bundle.
SKIN_MAKE_DIR=
# Empty uses workspaces/pretrained-skin/<pinned-revision>/ under the repository.
SKIN_PRETRAINED_DIR=
# Uncalibrated rejection heuristics, fixed before external evaluation.
SKIN_PRETRAINED_MIN_CONFIDENCE=0.70
SKIN_PRETRAINED_MIN_MARGIN=0.15
SKIN_PRETRAINED_THREADS=2
